<Window x:Class="FluentLegionToolbar.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid x:Name="Root" Padding="24,16,24,20" RowSpacing="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid x:Name="TitleBar" Height="36"><TextBlock x:Name="DeviceTitle" Text="Legion 5 15ITH6H" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid>
<StackPanel Grid.Row="1" Spacing="12">
<Grid><TextBlock x:Name="BatteryHeader" Text="MY BATTERY" FontWeight="SemiBold" VerticalAlignment="Center"/><HyperlinkButton x:Name="BatteryLink" Content="Battery details" HorizontalAlignment="Right" Click="BatteryDetails" /></Grid>
<Grid Height="100" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
<Border BorderThickness="2" CornerRadius="8" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" Padding="5">
<Grid><Border x:Name="BatteryFill" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" HorizontalAlignment="Left" />
<StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon x:Name="PlugIcon" Glyph="&#xE945;" FontSize="28"/><TextBlock x:Name="PercentText" Text="--%" FontSize="44" FontWeight="SemiBold"/></StackPanel></Grid></Border>
<Border Grid.Column="1" Background="{ThemeResource TextFillColorSecondaryBrush}" Height="30" CornerRadius="0,3,3,0"/></Grid>
<TextBlock x:Name="ChargeText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
</StackPanel>
<StackPanel Grid.Row="2" Spacing="10"><Grid><TextBlock x:Name="SettingsHeader" Text="QUICK SETTINGS" FontWeight="SemiBold" VerticalAlignment="Center"/><HyperlinkButton x:Name="AllLink" Content="All settings" HorizontalAlignment="Right" Click="AllSettings"/></Grid>
<Border CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12,18">
<Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel Spacing="8"><Button x:Name="Camera" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Click="CameraSettings"><FontIcon Glyph="&#xE722;" FontSize="24" FontFamily="Segoe Fluent Icons"/></Button><TextBlock x:Name="CameraLabel" Text="Camera" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
<StackPanel Grid.Column="1" Spacing="8"><ToggleButton x:Name="Microphone" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Click="MicClick" IsEnabled="False"><FontIcon Glyph="&#xE720;" FontSize="24" FontFamily="Segoe Fluent Icons"/></ToggleButton><TextBlock x:Name="MicLabel" Text="Mute" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
<StackPanel Grid.Column="2" Spacing="8"><ToggleButton x:Name="Conservation" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Click="ConservationClick" IsEnabled="False"><FontIcon Glyph="&#xEA93;" FontSize="24" FontFamily="Segoe Fluent Icons"/></ToggleButton><TextBlock x:Name="ConservationLabel" Text="Conserve" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
<StackPanel Grid.Column="3" Spacing="8"><ToggleButton x:Name="Rapid" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Click="RapidClick" IsEnabled="False"><FontIcon Glyph="&#xE945;" FontSize="24" FontFamily="Segoe Fluent Icons"/></ToggleButton><TextBlock x:Name="RapidLabel" Text="Rapid" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
<StackPanel Grid.Column="4" Spacing="8"><ToggleButton x:Name="Touchpad" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Click="TouchpadClick" IsEnabled="False"><FontIcon Glyph="&#xE7C9;" FontSize="24" FontFamily="Segoe Fluent Icons"/></ToggleButton><TextBlock x:Name="TouchpadLabel" Text="Lock" FontSize="11" HorizontalAlignment="Center"/></StackPanel>

</Grid></Border></StackPanel>
<TextBlock Grid.Row="3" x:Name="CameraNote" Text="Camera privacy uses the laptop's physical shutter." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<TextBlock Grid.Row="4" x:Name="Status" TextWrapping="Wrap" FontSize="12" MaxHeight="60" />
<Grid Grid.Row="5"><StackPanel Orientation="Horizontal" Spacing="2"><Button x:Name="LanguageButton" Content="العربية" Click="ChangeLanguage" Background="Transparent" BorderThickness="0"/><Button x:Name="ThemeButton" Content="◐" Click="ChangeTheme" Background="Transparent" BorderThickness="0"/></StackPanel><HyperlinkButton x:Name="WarrantyLink" Content="Warranty options" HorizontalAlignment="Right" Click="Warranty"/></Grid>
</Grid>
</Window>
